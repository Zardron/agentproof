{
  "name": "agentproof",
  "version": "0.1.0",
  "description": "Verify AI-assisted code before it reaches production. AgentProof checks the code change, not who or what wrote it.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "agentproof": "./dist/cli/index.js"
  },
  "main": "./dist/cli/index.js",
  "exports": {
    ".": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "agentproof": "node dist/cli/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ci",
    "security",
    "ai-code",
    "verification",
    "typescript",
    "github-actions"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/agentproof/agentproof"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "cosmiconfig": "^9.0.0",
    "execa": "^9.5.2",
    "js-yaml": "^4.1.0",
    "micromatch": "^4.0.8",
    "parse-diff": "^0.11.1",
    "simple-git": "^3.27.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/micromatch": "^4.0.9",
    "@types/node": "^22.13.10",
    "pnpm": "^9.15.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
